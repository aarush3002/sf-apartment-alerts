# Optional secrets. Copy to .env and fill in only what you use.
# Recipient can also be set here instead of config.yaml:
# APTBOT_TO=+19253364049,+15106048224   (comma-separated list also works)

# Twilio SMS (only if you enable the twilio channel in config.yaml)
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM=+1XXXXXXXXXX

# ntfy push (only if you enable the ntfy channel)
# NTFY_TOPIC=some-long-random-topic-name
